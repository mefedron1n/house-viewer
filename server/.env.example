# HTTP server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated browser origins allowed to call the API directly.
# Same-origin requests through the local Nginx proxy need no CORS entry.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Exact public API/proxy hosts, with a port when non-standard.
ALLOWED_HOSTS=localhost:3001,127.0.0.1:3001,localhost:8080,127.0.0.1:8080
# Set to 1 only when the API is behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0

# Local storage. Only "local" is implemented until R2 credentials exist.
STORAGE_DRIVER=local
MODEL_STORAGE_DIR=./data/models
TEMP_DIR=./data/tmp

# IFC conversion
IFC_CONVERT_PATH=IfcConvert
MAX_IFC_UPLOAD_MB=100
MAX_GLB_UPLOAD_MB=100
MAX_IMAGE_UPLOAD_MB=15
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
MAX_IMAGE_PIXELS=40000000
JSON_BODY_LIMIT=32kb
CONVERSION_TIMEOUT_MS=300000
MAX_CONCURRENT_CONVERSIONS=1
MAX_CONVERSION_QUEUE=10
MAX_USER_CONVERSION_JOBS=2
MODEL_TTL_HOURS=24
TEMP_FILE_TTL_HOURS=24

# In-memory limiter for IFC uploads; applies per backend process.
CONVERSION_RATE_LIMIT_WINDOW_MS=3600000
CONVERSION_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5

# Required in production. Use a long random value; never commit it.
UPLOAD_PASSWORD=

# Cookie session lifetime.
SESSION_MAX_AGE_HOURS=720

# Graceful shutdown waits this long for active conversions.
SHUTDOWN_TIMEOUT_MS=15000
